# Hugo build output and caches
/public/
/resources/_gen/
.hugo_build.lock
# Hugo writes this to help editors resolve JS module imports; regenerated.
/assets/jsconfig.json

# exampleSite build output (regenerated by `hugo -s exampleSite`)
/exampleSite/public/
/exampleSite/resources/

# Pagefind search index (regenerated by `pagefind --site <public>`)
/exampleSite/public/pagefind/

# Drafts, archive and competition entries — kept locally, outside the theme
# product. Never committed.
/local/

# Plot vendor build (scripts/vendor-plot): packages and esbuild's metafile
/scripts/vendor-plot/node_modules/
/scripts/vendor-plot/meta.json

# OS junk
.DS_Store
